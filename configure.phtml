<script>
function toggleScopePanels() {
    var selected = document.querySelector('input[name="scope_mode"]:checked');
    var mode = selected ? selected.value : 'feed';
    var catPanel = document.getElementById('panel_category');
    var feedPanel = document.getElementById('panel_feed');
    if (catPanel) catPanel.style.display = (mode === 'category') ? 'block' : 'none';
    if (feedPanel) feedPanel.style.display = (mode === 'feed') ? 'block' : 'none';
}

function toggleAllCheckboxes(containerId, checkState) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var checkboxes = container.querySelectorAll('input[type="checkbox"]');
    for (var i = 0; i < checkboxes.length; i++) {
        checkboxes[i].checked = checkState;
    }
}
</script>