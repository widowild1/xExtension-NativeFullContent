    $scopeMode = (string) ($extension->getUserConfigurationValue('scope_mode') ?: 'feed');
    $rawCats = $extension->getUserConfigurationValue('enabled_categories');
    $enabledCategories = is_array($rawCats) ? array_map('strval', $rawCats) : [];

