<script>
function nativeRunTest() {
    var urlInput = document.getElementById('native_test_url');
    var url = urlInput ? urlInput.value.trim() : '';
    var resultContainer = document.getElementById('native_test_output');
    var btnTest = document.getElementById('native_btn_run_test');

    if (!url) {
        alert('Veuillez saisir une URL complète (ex: https://...).');
        return;
    }

    if (btnTest) {
        btnTest.disabled = true;
        btnTest.innerHTML = 'Analyse en cours...';
    }
    if (resultContainer) {
        resultContainer.style.display = 'block';
        resultContainer.innerHTML = '<em>Connexion et extraction du document distant...</em>';
    }

    var csrfInput = document.getElementById('native_csrf_token');
    var csrfToken = csrfInput ? csrfInput.value : '';

    var formData = new FormData();
    formData.append('ajax_action', 'test');
    formData.append('url', url);
    formData.append('_csrf', csrfToken);

    // Envoi direct à la page de configuration courante
    fetch(window.location.href, {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (res) {
        return res.text().then(function (text) {
            try {
                return JSON.parse(text);
            } catch (e) {
                throw new Error('Réponse serveur inattendue (code ' + res.status + ') : ' + text.substring(0, 250));
            }
        });
    })
    .then(function (data) {
        if (btnTest) {
            btnTest.disabled = false;
            btnTest.innerHTML = 'Tester l\'extraction';
        }
        if (!resultContainer) return;

        if (data.success) {
            resultContainer.innerHTML = 
                '<div class="native-test-card">' +
                    '<h4 style="margin-top: 0;">Résultat de l\'analyse</h4>' +
                    '<ul>' +
                        '<li><strong>Hôte :</strong> ' + data.debug.host + '</li>' +
                        '<li><strong>Moteur utilisé :</strong> ' + data.debug.engine + '</li>' +
                        '<li><strong>Longueur extraite :</strong> ' + data.length + ' caractères</li>' +
                    '</ul>' +
                    '<details style="margin-top: 10px;" open>' +
                        '<summary style="cursor: pointer; font-weight: bold;">Aperçu du texte extrait</summary>' +
                        '<div class="native-preview-box">' + data.html + '</div>' +
                    '</details>' +
                '</div>';
        } else {
            resultContainer.innerHTML = 
                '<div class="native-test-card error">' +
                    '<strong>Échec de l\'analyse :</strong> ' + (data.error || 'Erreur inconnue') +
                '</div>';
        }
    })
    .catch(function (err) {
        if (btnTest) {
            btnTest.disabled = false;
            btnTest.innerHTML = 'Tester l\'extraction';
        }
        if (resultContainer) {
            resultContainer.innerHTML = '<div class="native-test-card error">' + err.message + '</div>';
        }
    });
}

function toggleScopePanels() {
    var selected = document.querySelector('input[name="scope_mode"]:checked');
    var mode = selected ? selected.value : 'feed';
    var catPanel = document.getElementById('panel_category');
    var feedPanel = document.getElementById('panel_feed');
    if (catPanel) catPanel.style.display = (mode === 'category') ? 'block' : 'none';
    if (feedPanel) feedPanel.style.display = (mode === 'feed') ? 'block' : 'none';
}

function toggleAllCheckboxes(containerId, checkState) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var checkboxes = container.querySelectorAll('input[type="checkbox"]');
    for (var i = 0; i < checkboxes.length; i++) {
        checkboxes[i].checked = checkState;
    }
}
</script>