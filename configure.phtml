<?php
require_once __DIR__ . '/lib/RuleLoader.php';

$extension = null;
if (isset($this->extension) && $this->extension instanceof Minz_Extension) {
    $extension = $this->extension;
} elseif (Minz_ExtensionManager::findExtension('NativeFullContent') !== null) {
    $extension = Minz_ExtensionManager::findExtension('NativeFullContent');
} elseif (Minz_ExtensionManager::findExtension('xExtension-NativeFullContent') !== null) {
    $extension = Minz_ExtensionManager::findExtension('xExtension-NativeFullContent');
}

$extName = $extension !== null ? $extension->getName() : 'NativeFullContent';

$scopeMode = 'feed';
$enabledCategories = [];
$enabledFeeds = [];
$userAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';
$timeout = 15;

if ($extension !== null) {
    $scopeMode = (string) ($extension->getUserConfigurationValue('scope_mode') ?: 'feed');
    
    $rawCats = $extension->getUserConfigurationValue('enabled_categories');
    $enabledCategories = is_array($rawCats) ? array_map('strval', $rawCats) : [];

    $rawFeeds = $extension->getUserConfigurationValue('enabled_feeds');
    $enabledFeeds = is_array($rawFeeds) ? array_map('strval', $rawFeeds) : [];

    $userAgent = (string) ($extension->getUserConfigurationValue('user_agent') ?: $userAgent);
    $timeout = (int) ($extension->getUserConfigurationValue('timeout') ?: 15);
}

// Récupération officielle des catégories et de leurs flux
$categoryDAO = FreshRSS_Factory::createCategoryDao();
$categories = $categoryDAO->listCategories(true);
if (!is_array($categories)) {
    $categories = [];
}

// Chargement des règles par domaine
$rulesDir = __DIR__ . '/rules';
$installedRules = [];
if (class_exists('RuleLoader') && is_dir($rulesDir)) {
    $ruleLoader = new RuleLoader($rulesDir);
    $installedRules = $ruleLoader->getAllRules();
}
?>

<h2>Configuration de FullText Native</h2>

<form action="<?php echo _url('extension', 'configure', 'e', $extName); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

    <div class="form-group">
        <label class="group-name" for="user_agent">User-Agent HTTP :</label>
        <div class="group-controls">
            <input type="text" id="user_agent" name="user_agent" class="text" style="width: 100%;" value="<?php echo htmlspecialchars($userAgent, ENT_QUOTES, 'UTF-8'); ?>" />
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="timeout">Timeout réseau (secondes) :</label>
        <div class="group-controls">
            <input type="number" id="timeout" name="timeout" min="2" max="60" value="<?php echo (int) $timeout; ?>" />
        </div>
    </div>

    <hr />

    <h3>Portée de l'extraction de texte intégral</h3>
    <div class="form-group">
        <label class="group-name">Mode d'application :</label>
        <div class="group-controls">
            <label class="radio">
                <input type="radio" name="scope_mode" value="all" onchange="toggleScopePanels()" <?php echo $scopeMode === 'all' ? 'checked' : ''; ?> />
                <strong>La totalité des flux</strong> (traiter automatiquement tous les flux)
            </label><br />
            <label class="radio">
                <input type="radio" name="scope_mode" value="category" onchange="toggleScopePanels()" <?php echo $scopeMode === 'category' ? 'checked' : ''; ?> />
                <strong>Par catégorie</strong> (traiter tous les flux appartenant aux catégories sélectionnées)
            </label><br />
            <label class="radio">
                <input type="radio" name="scope_mode" value="feed" onchange="toggleScopePanels()" <?php echo $scopeMode === 'feed' ? 'checked' : ''; ?> />
                <strong>À l'unité</strong> (sélection manuelle au cas par cas)
            </label>
        </div>
    </div>

    <!-- Panel Catégories -->
    <div id="panel_category" style="<?php echo $scopeMode === 'category' ? 'display: block;' : 'display: none;'; ?> margin-top: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <h4 style="margin: 0;">Sélectionner les catégories :</h4>
            <div>
                <button type="button" class="btn btn-smaller" onclick="toggleAllCheckboxes('panel_category', true)">Tout cocher</button>
                <button type="button" class="btn btn-smaller" onclick="toggleAllCheckboxes('panel_category', false)">Tout décocher</button>
            </div>
        </div>
        <div style="max-height: 250px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; background: #fafafa;">
            <?php if (empty($categories)): ?>
                <em>Aucune catégorie trouvée.</em>
            <?php else: ?>
                <?php foreach ($categories as $category): ?>
                    <?php $feedList = is_array($category->feeds()) ? $category->feeds() : []; ?>
                    <label class="checkbox" style="display: block; margin-bottom: 4px;">
                        <input type="checkbox" name="enabled_categories[]" value="<?php echo (string)$category->id(); ?>" <?php echo in_array((string)$category->id(), $enabledCategories, true) ? 'checked' : ''; ?> />
                        <strong><?php echo htmlspecialchars($category->name(), ENT_QUOTES, 'UTF-8'); ?></strong>
                        <small style="color: #666;">(<?php echo count($feedList); ?> flux)</small>
                    </label>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    </div>

    <!-- Panel Flux individuels -->
    <div id="panel_feed" style="<?php echo $scopeMode === 'feed' ? 'display: block;' : 'display: none;'; ?> margin-top: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <h4 style="margin: 0;">Sélectionner les flux à l'unité :</h4>
            <div>
                <button type="button" class="btn btn-smaller" onclick="toggleAllCheckboxes('panel_feed', true)">Tout cocher</button>
                <button type="button" class="btn btn-smaller" onclick="toggleAllCheckboxes('panel_feed', false)">Tout décocher</button>
            </div>
        </div>
        <div style="max-height: 350px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; background: #fafafa;">
            <?php if (empty($categories)): ?>
                <em>Aucun flux disponible.</em>
            <?php else: ?>
                <?php foreach ($categories as $category): ?>
                    <?php $feedList = is_array($category->feeds()) ? $category->feeds() : []; ?>
                    <h5 style="margin: 10px 0 4px 0; border-bottom: 1px solid #ddd; padding-bottom: 2px;">
                        📁 <?php echo htmlspecialchars($category->name(), ENT_QUOTES, 'UTF-8'); ?>
                    </h5>
                    <div style="margin-left: 15px; margin-bottom: 8px;">
                        <?php if (empty($feedList)): ?>
                            <em style="color: #888; font-size: 0.9em;">Aucun flux dans cette catégorie.</em><br />
                        <?php else: ?>
                            <?php foreach ($feedList as $feed): ?>
                                <label class="checkbox" style="display: block; margin-bottom: 3px;">
                                    <input type="checkbox" name="enabled_feeds[]" value="<?php echo (string)$feed->id(); ?>" <?php echo in_array((string)$feed->id(), $enabledFeeds, true) ? 'checked' : ''; ?> />
                                    <?php echo htmlspecialchars($feed->name(), ENT_QUOTES, 'UTF-8'); ?>
                                </label>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    </div>

    <hr />

    <h3>Règles par domaine actives (<code>rules/*.json</code>)</h3>
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9em;">
        <thead>
            <tr style="background: #f0f0f0; border-bottom: 2px solid #ccc;">
                <th style="padding: 6px;">Domaine</th>
                <th style="padding: 6px;">Sélecteur de contenu</th>
                <th style="padding: 6px;">Éléments exclus</th>
            </tr>
        </thead>
        <tbody>
            <?php if (empty($installedRules)): ?>
                <tr>
                    <td colspan="3" style="padding: 10px; color: #777;">Aucun fichier de règle trouvé dans le dossier <code>rules/</code>.</td>
                </tr>
            <?php else: ?>
                <?php foreach ($installedRules as $domain => $rule): ?>
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 6px;"><strong><?php echo htmlspecialchars($domain, ENT_QUOTES, 'UTF-8'); ?></strong></td>
                        <td style="padding: 6px;"><code><?php echo htmlspecialchars($rule['content'] ?? '', ENT_QUOTES, 'UTF-8'); ?></code></td>
                        <td style="padding: 6px; color: #888;"><code><?php echo htmlspecialchars($rule['strip'] ?? '-', ENT_QUOTES, 'UTF-8'); ?></code></td>
                    </tr>
                <?php endforeach; ?>
            <?php endif; ?>
        </tbody>
    </table>

    <div class="form-actions" style="margin-top: 20px;">
        <button type="submit" class="btn btn-important">Enregistrer les options</button>
    </div>
</form>

<script>
function toggleScopePanels() {
    var selected = document.querySelector('input[name="scope_mode"]:checked');
    var mode = selected ? selected.value : 'feed';
    var catPanel = document.getElementById('panel_category');
    var feedPanel = document.getElementById('panel_feed');
    if (catPanel) {
        catPanel.style.display = (mode === 'category') ? 'block' : 'none';
    }
    if (feedPanel) {
        feedPanel.style.display = (mode === 'feed') ? 'block' : 'none';
    }
}

function toggleAllCheckboxes(containerId, checkState) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var checkboxes = container.querySelectorAll('input[type="checkbox"]');
    for (var i = 0; i < checkboxes.length; i++) {
        checkboxes[i].checked = checkState;
    }
}
</script>