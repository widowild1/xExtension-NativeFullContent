<?php
$enabledFeeds = $this->getUserConfigurationValue('enabled_feeds');
if (!is_array($enabledFeeds)) {
    $enabledFeeds = [];
}
$userAgent = $this->getUserConfigurationValue('user_agent') ?: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';
$timeout = $this->getUserConfigurationValue('timeout') ?: 15;

$feedDAO = FreshRSS_Factory::createFeedDao();
$categories = $feedDAO->selectAllWithCategory();
?>

<h2>Configuration de FullText Native</h2>

<form action="<?php echo _url('extension', 'configure', 'e', $this->getName()); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

    <div class="form-group">
        <label class="group-name" for="user_agent">User-Agent personnalisé :</label>
        <div class="group-controls">
            <input type="text" id="user_agent" name="user_agent" class="text" style="width: 100%;" value="<?php echo htmlspecialchars($userAgent, ENT_QUOTES, 'UTF-8'); ?>" />
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="timeout">Timeout réseau (secondes) :</label>
        <div class="group-controls">
            <input type="number" id="timeout" name="timeout" min="2" max="60" value="<?php echo (int) $timeout; ?>" />
        </div>
    </div>

    <hr />

    <h3>Activer le texte complet pour les flux suivants :</h3>
    <p><em>Seuls les flux cochés seront scrapés pour extraire l'article complet.</em></p>

    <div style="max-height: 400px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; margin-bottom: 20px;">
        <?php foreach ($categories as $category): ?>
            <h4><?php echo htmlspecialchars($category->name(), ENT_QUOTES, 'UTF-8'); ?></h4>
            <div style="margin-left: 20px; margin-bottom: 10px;">
                <?php foreach ($category->feeds() as $feed): ?>
                    <label class="checkbox">
                        <input type="checkbox" name="enabled_feeds[]" value="<?php echo (string)$feed->id(); ?>" <?php echo in_array((string)$feed->id(), $enabledFeeds, true) ? 'checked' : ''; ?> />
                        <?php echo htmlspecialchars($feed->name(), ENT_QUOTES, 'UTF-8'); ?>
                    </label><br />
                <?php endforeach; ?>
            </div>
        <?php endforeach; ?>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-important">Enregistrer la configuration</button>
    </div>
</form>